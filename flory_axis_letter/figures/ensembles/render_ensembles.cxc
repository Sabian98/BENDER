# ChimeraX 1.12 script for Figure 1 of the JPC Letter. Run from this folder:
#   /Applications/ChimeraX-1.12.app/Contents/MacOS/ChimeraX --nostatus --exit render_ensembles.cxc
# Frame 1 (closest to the mean radius of gyration) is drawn as beads colored by charge (blue Lys/Arg, red Asp/Glu,
# gray otherwise); frames 2 to 10 form a faint cloud. All images use 0.3 A per pixel, so sizes compare directly.
set bgColor white
lighting soft
graphics silhouettes true width 0.8
open frames/compact_A0A540LLY7_cal_f*.pdb
hide atoms
cartoon
cartoon suppressBackboneDisplay false
color #2-10 #BCBCBC target c
transparency #2-10 65 target c
color #1 #8C8C8C target c
show #1 atoms
style #1 sphere
size #1 atomRadius 2.0
color #1 #A6A6A6 target a
color #1 & (:LYS | :ARG) #537A9E target a
color #1 & (:ASP | :GLU) #CA534E target a
view
zoom pixelSize 0.3
save compact_A0A540LLY7_cal.png width 900 height 900 supersample 3
close
open frames/compact_A0A540LLY7_rch_f*.pdb
hide atoms
cartoon
cartoon suppressBackboneDisplay false
