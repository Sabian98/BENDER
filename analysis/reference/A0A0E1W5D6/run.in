# Coulombic interactions between charged residues
pair_coeff 4 4 coul/debye 35.
pair_coeff 4 6 coul/debye 35.
pair_coeff 4 11 coul/debye 35.
pair_coeff 6 6 coul/debye 35.
pair_coeff 6 11 coul/debye 35.
pair_coeff 11 11 coul/debye 35.

# FENE special bonds (excludes 1-2 bonded pairs from non-bonded)
special_bonds fene

# Communication cutoff > pair cutoff (prevents bond atoms missing error)
comm_modify cutoff 40.0
comm_style brick

# Neighbor list
neighbor 3.5 bin
neigh_modify every 1 delay 0 check yes

# Energy minimization (remove bad contacts from starting config)
minimize 0.0 0.00000001 1000 100000

# MD settings
timestep 20
timer normal

# NVE + Langevin thermostat = NVT at 300K
fix fxnve    all nve
fix fxlange  all langevin 300 300 5000.0 87992

# Save trajectory every 999 steps (20 ps)
# Start saving after equilibration (4995000 steps = 100 ns)
dump 1 all xtc 999 traj.xtc
dump_modify 1 sort id
dump_modify 1 delay 4995000

# Radius of gyration output
compute rad all gyration
fix fxrg all ave/time 999 1 999 c_rad start 4995000 file Rg.out

thermo 999
thermo_style custom step pe press ke temp lx ly lz spcpu
thermo_modify flush yes

# Initialize velocities at 300K
velocity all create 300.0 87992 rot yes dist gaussian

restart 4995000 restart
run 9990000